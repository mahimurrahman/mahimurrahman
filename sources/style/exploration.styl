.exploration-hud
    display none
    position absolute
    top 20px
    left 20px
    z-index 9
    padding 8px 14px
    background radial-gradient(ellipse at top left, rgba(37, 31, 43, 0.92), rgba(29, 23, 33, 0.92))
    border 1px solid rgba(255, 255, 255, 0.25)
    border-radius 6px
    color #ffffff
    font-family "Nunito", sans-serif
    font-size 14px
    font-weight 700
    line-height 1.2
    letter-spacing 0.01em
    display flex
    align-items center
    gap 8px
    cursor pointer
    user-select none
    -webkit-user-select none
    transition transform 0.15s ease, border-color 0.15s ease, opacity 0.2s ease

    &:not(.is-ready)
        display none

    html.input-filter-menu &
    html.input-filter-modal &
    html.input-filter-intro &
    html.input-filter-cinematic &
        opacity 0
        pointer-events none
        transform translateY(-8px)

    html:not(.is-mode-touch) &:hover
        border-color #ffceca
        transform translateY(-1px)

    .hud-star
        display inline-flex
        align-items center
        justify-content center
        width 16px
        height 16px
        color #ffd479
        flex-shrink 0

    .hud-text
        font-variant-numeric tabular-nums
        white-space nowrap

    &.is-complete
        border-color rgba(213, 255, 149, 0.55)

        .hud-star
            color #d5ff95

    @media only screen and (max-width 520px)
        top 14px
        left 14px
        padding 7px 11px
        font-size 13px

.notifications
    .notification.is-discovery
        .top
            display flex
            justify-content space-between
            align-items center
            margin-bottom 4px

            .title
                text-align left
                color #ffd479
                font-size 1.65rem
                margin-right 10px
                margin-bottom 0
                line-height 1.05

            .progress
                font-weight 700
                color #ffceca
                font-variant-numeric tabular-nums
                white-space nowrap

        .bottom
            .description
                margin-bottom 0
                color rgba(255, 255, 255, 0.9)
                line-height 1.3
                font-size 15px

        .time-bar
            background #ffd479

.modal.exploration-modal
    .container
        width 540px
        max-width calc(100vw - 32px)

    .content
        border 1px solid rgba(255, 255, 255, 0.18)
        border-radius 8px

    .exploration-kicker
        font-size 0.78rem
        font-weight 700
        letter-spacing 0.08em
        text-transform uppercase
        color #ffd479
        margin-bottom 0.35em

    .exploration-title
        font-family "Amatic SC", sans-serif
        font-size 2.5rem
        font-weight 700
        line-height 1.05
        color #ffffff
        margin-bottom 0.45em
        padding-right 36px

    .exploration-body
        font-size 0.95rem
        line-height 1.6
        color rgba(255, 255, 255, 0.9)
        margin-bottom 1em

        p
            margin-bottom 0.8em

            &:last-child
                margin-bottom 0

    .exploration-quote
        margin 1em 0
        padding 0.75em 1em
        border 1px solid rgba(255, 206, 202, 0.32)
        border-radius 6px
        background rgba(255, 255, 255, 0.04)
        font-style italic
        color #ffceca
        font-size 0.95rem
        line-height 1.5

    .exploration-footer-note
        font-size 0.82rem
        color rgba(255, 255, 255, 0.68)
        margin-top 0.85em
        padding-top 0.75em
        border-top 1px solid rgba(255, 255, 255, 0.12)

    .exploration-checklist
        list-style none
        padding-left 0
        margin 1em 0 1.25em 0
        display grid
        gap 8px

        li
            display flex
            align-items center
            justify-content space-between
            gap 12px
            padding 9px 12px
            border 1px solid rgba(255, 255, 255, 0.14)
            border-radius 6px
            background rgba(255, 255, 255, 0.03)
            font-size 0.88rem

            .item-label
                color rgba(255, 255, 255, 0.92)

            .item-status
                font-size 0.8rem
                font-weight 700
                font-variant-numeric tabular-nums
                color rgba(255, 255, 255, 0.55)
                white-space nowrap

            &.is-done
                border-color rgba(213, 255, 149, 0.35)
                background rgba(213, 255, 149, 0.06)

                .item-status
                    color #d5ff95

    .exploration-actions
        display flex
        flex-wrap wrap
        gap 10px
        margin-top 1.15em

        .button
            height 46px
            line-height 46px
            font-size 0.9rem
